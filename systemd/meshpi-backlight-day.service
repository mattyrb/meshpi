[Unit]
Description=meshpi: turn touchscreen backlight on and set day brightness

[Service]
Type=oneshot
# bl_power=0 powers the LEDs back on (in case night had turned them off),
# then write the day brightness value.
# Adjust the path to match your display (e.g. 10-0045 on newer kernels).
ExecStart=/bin/sh -c 'echo 0 > /sys/class/backlight/rpi_backlight/bl_power || true; echo 200 > /sys/class/backlight/rpi_backlight/brightness || true'
